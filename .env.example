PORT=3001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
# Comma-separated CORS allowlist (add the staging frontend origin here)
FRONTEND_ORIGIN=http://localhost:3000,https://www.gloxadacademy.com,https://gloxadacademy.com

# Optional SMTP configuration for email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@gloxad.com

# Optional AWS S3 configuration for direct presigned media offloading
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=gloxad-media-bucket
# Optional LiveKit (live classes). Without these, POST /api/lms/live-sessions/:id/join returns configured:false
# and the frontend shows its preview room instead of video.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Timezone offset (minutes from UTC) used to decide which LMS day is "today". Default 60 (WAT).
LMS_TZ_OFFSET_MINUTES=60
